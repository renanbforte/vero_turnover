# =============================================================================
# .env.example — as variaveis que o servidor le
# -----------------------------------------------------------------------------
# COPIE para `.env` no seu computador. No Easypanel, cole estes pares no campo
# "Environment" do servico -- la nao existe arquivo .env.
#
# ⚠️ O `.env` de verdade NUNCA vai para o Git (ver .gitignore). Se uma chave
# vazar num commit, considere-a queimada: apagar o commit depois nao adianta,
# porque quem clonou ja tem. Gere outra.
# =============================================================================

# --- OBRIGATORIAS ------------------------------------------------------------

# O banco. No Easypanel, use o hostname INTERNO do servico de Postgres
# (algo como `vero_postgres`), e nao o endereco publico: assim o trafego nao
# sai da rede do projeto.
DATABASE_URL=postgresql://usuario:senha@host:5432/vero

# A chave da OpenAI. E ela que paga cada resposta do chat.
OPENAI_API_KEY=sk-troque-por-uma-chave-de-verdade

# A senha unica do chat. Quem tiver o link do painel ve os graficos sem senha;
# so o CHAT pede esta. Troque por algo longo -- ela vai circular por mensagem.
RH_CHAT_SENHA=troque-esta-senha

# Quem pode conversar com o agente, separado por virgula. VAZIO = NINGUEM,
# e isso e proposital: um erro de digitacao aqui fecha o acesso, nunca abre.
RH_PERFIS_AUTORIZADOS=banca,diretoria

# --- CUSTO: o que impede uma surpresa na fatura ------------------------------

# Teto de gasto por dia, em dolares. Ao estourar, o chat recusa educadamente e
# o painel continua funcionando (ele nao usa modelo nenhum).
TETO_DIARIO_USD=5
TETO_DIARIO_MODO=bloquear

# Quantas requisicoes cada login pode fazer por minuto, e o teto global.
LIMITE_POR_IDENTIDADE=10
LIMITE_GLOBAL=60

# Quantas vezes o agente pode chamar o modelo numa unica pergunta.
MAX_CHAMADAS_MODELO=6
MAX_FERRAMENTAS_POR_REQUISICAO=8
TIMEOUT_MODELO=60

# --- OPCIONAIS ---------------------------------------------------------------

MODELO=gpt-4o-mini
LOG_NIVEL=INFO

# A data do retrato. So muda se voce recarregar a base com outra planilha.
RH_DATA_BASE=2026-06-30

# Rastreamento no LangSmith. Deixe `false` se nao usa.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=vero-turnover

# Sumarizacao da conversa longa.
SUMARIZAR_ACIMA_DE=20
SUMARIZACAO_MANTER=6
